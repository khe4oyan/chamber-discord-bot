generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  username        String    @unique
  longest_streaks Int       @default(1)
  current_streaks Int       @default(1)
  last_checkin_at DateTime? @default(now())
}

model Settings {
  title   String @unique
  version Int    @default(1)
}
